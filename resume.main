<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>InternLoom — Dynamic Smart Shortlisting Engine</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- PDF.js for reading uploaded PDF Resumes directly in browser -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
  <script>
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
  </script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased">

  <!-- Header -->
  <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="bg-indigo-600 p-2 rounded-lg text-white">
          <i data-lucide="cpu" class="w-5 h-5"></i>
        </div>
        <div>
          <span class="font-bold text-lg tracking-tight bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">InternLoom AI</span>
          <span class="text-xs text-slate-400 block -mt-1">Dynamic Candidate Evaluator Engine</span>
        </div>
      </div>
      <div class="flex items-center space-x-3">
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          Evaluated Resumes: <span id="poolBadge">0</span>
        </span>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-7xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Left Column: Inputs & Controls -->
    <section class="lg:col-span-5 space-y-6">
      
      <!-- 1. Job Description Input -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-3">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <h2 class="font-semibold text-slate-200 text-sm flex items-center gap-2">
            <i data-lucide="file-text" class="w-4 h-4 text-indigo-400"></i>
            1. Job Description Input
          </h2>
          <span class="text-[10px] bg-slate-800 px-2 py-0.5 rounded text-slate-400 font-mono">Dynamic AI Context</span>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Target Role Title</label>
          <input id="jdTitle" type="text" value="Backend Developer (Node.js & Cloud)" 
            class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:border-indigo-500 outline-none">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Paste Job Requirements / Skills</label>
          <textarea id="jdText" rows="4" 
            class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-xs text-slate-300 focus:border-indigo-500 outline-none leading-relaxed"
            placeholder="Type or paste requirements...">Looking for a Backend Engineer with experience in Node.js, Express, MongoDB, AWS, Docker, and REST APIs. Experience writing unit tests with Jest or Mocha is required.</textarea>
        </div>
      </div>

      <!-- 2. Student Resumes Input (PDF Dropzone + Manual Text Box) -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <h2 class="font-semibold text-slate-200 text-sm flex items-center gap-2">
            <i data-lucide="users" class="w-4 h-4 text-indigo-400"></i>
            2. Add Student Resumes
          </h2>
          <span class="text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded font-mono">PDF Reader Enabled</span>
        </div>

        <!-- File Upload Dropzone -->
        <div class="border-2 border-dashed border-slate-800 hover:border-indigo-500/50 rounded-xl p-4 text-center transition bg-slate-950/50">
          <input type="file" id="fileInput" multiple accept=".pdf,.txt" class="hidden" onchange="handleFileUpload(event)">
          <label for="fileInput" class="cursor-pointer space-y-2 block">
            <i data-lucide="upload-cloud" class="w-6 h-6 text-indigo-400 mx-auto"></i>
            <div class="text-xs text-slate-300 font-medium">Click or Drag PDF / TXT Resumes Here</div>
            <div class="text-[10px] text-slate-500">Supports uploading multiple files at once</div>
          </label>
        </div>

        <!-- Manual Quick Add Text Form -->
        <div class="pt-2 border-t border-slate-800 space-y-2">
          <div class="text-xs text-slate-400 font-medium">Or Quickly Add Candidate Manually:</div>
          <input id="manualName" type="text" placeholder="Candidate Name (e.g. Rahul Verma)" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-slate-200 outline-none">
          <textarea id="manualText" rows="3" placeholder="Paste Resume text summary here (e.g., Experienced in Python, Django, Docker...)" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-xs text-slate-300 outline-none"></textarea>
          <button onclick="addManualCandidate()" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs py-1.5 rounded-lg font-medium transition flex items-center justify-center gap-1.5">
            <i data-lucide="plus-circle" class="w-3.5 h-3.5 text-indigo-400"></i> Add Candidate to Pool
          </button>
        </div>
      </div>

      <!-- 3. Dynamic Algorithm Tuning -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <h3 class="font-semibold text-slate-200 text-sm flex items-center gap-2">
            <i data-lucide="sliders" class="w-4 h-4 text-indigo-400"></i>
            3. Algorithm Weights
          </h3>
        </div>

        <div class="space-y-3">
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300">Semantic Matching Weight</span>
              <span id="semWeightText" class="font-mono text-indigo-400">60%</span>
            </div>
            <input type="range" id="semWeightSlider" min="0" max="100" value="60" oninput="updateWeightsUI()" class="w-full accent-indigo-500 h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer">
          </div>
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300">Exact Keyword Match Weight</span>
              <span id="keyWeightText" class="font-mono text-emerald-400">40%</span>
            </div>
            <input type="range" id="keyWeightSlider" min="0" max="100" value="40" disabled class="w-full accent-emerald-500 h-1 bg-slate-800 rounded-lg opacity-40">
          </div>
        </div>

        <button onclick="evaluatePool()" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2.5 rounded-lg text-xs flex items-center justify-center gap-2 transition shadow-lg shadow-indigo-600/20">
          <i data-lucide="play" class="w-4 h-4"></i> Evaluate & Rank Candidates Live
        </button>
      </div>

    </section>

    <!-- Right Column: Results & Explainability Output -->
    <section class="lg:col-span-7 space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-semibold text-xl text-slate-100">Evaluated Candidate Shortlist</h2>
          <p class="text-xs text-slate-400">Live updated rankings and explainability breakdowns.</p>
        </div>
        <button onclick="clearPool()" class="text-xs text-rose-400 hover:text-rose-300 bg-rose-500/10 border border-rose-500/20 px-3 py-1.5 rounded-lg transition flex items-center gap-1">
          <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Clear All
        </button>
      </div>

      <!-- Candidate Output List -->
      <div id="resultsContainer" class="space-y-4">
        <!-- Placeholder Empty State -->
        <div id="emptyState" class="border border-slate-800 border-dashed rounded-xl p-12 text-center text-slate-500 space-y-3">
          <i data-lucide="inbox" class="w-10 h-10 mx-auto text-slate-600"></i>
          <p class="text-xs">No candidates added yet. Upload PDF resumes or manually add students on the left panel, then click <strong>"Evaluate & Rank Candidates Live"</strong>.</p>
        </div>
      </div>
    </section>

  </main>

  <script>
    lucide.createIcons();

    // In-memory Candidate Store
    let currentPool = [];

    // Semantic Knowledge Map (Maps candidate synonyms/frameworks to core JD skill concepts)
    const semanticMap = {
      "express": "Node.js", "express.js": "Node.js", "nest.js": "Node.js", "koa": "Node.js",
      "fastapi": "Python", "flask": "Python", "django": "Python",
      "postgres": "PostgreSQL", "postgres": "SQL", "mysql": "SQL", "sqlite": "SQL",
      "mongo": "MongoDB", "mongoose": "MongoDB",
      "jest": "Unit Testing", "mocha": "Unit Testing", "pytest": "Unit Testing", "cypress": "Testing",
      "github actions": "CI/CD", "jenkins": "CI/CD", "gitlab ci": "CI/CD",
      "aws s3": "AWS", "ec2": "AWS", "lambda": "AWS",
      "react": "Frontend", "vue": "Frontend", "next.js": "Frontend", "tailwind": "Frontend UI"
    };

    function updateWeightsUI() {
      const semVal = parseInt(document.getElementById('semWeightSlider').value);
      document.getElementById('semWeightText').innerText = `${semVal}%`;
      document.getElementById('keyWeightText').innerText = `${100 - semVal}%`;
    }

    // PDF Extraction Engine
    async function extractTextFromPDF(file) {
      const arrayBuffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      let fullText = "";
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const textContent = await page.getTextContent();
        fullText += textContent.items.map(item => item.str).join(" ") + " ";
      }
      return fullText;
    }

    // Handle File Uploads (PDF & TXT)
    async function handleFileUpload(event) {
      const files = event.target.files;
      if (!files.length) return;

      for (let file of files) {
        let text = "";
        if (file.name.endsWith('.pdf')) {
          text = await extractTextFromPDF(file);
        } else {
          text = await file.text();
        }

        currentPool.push({
          id: "C-" + Math.floor(100 + Math.random() * 900),
          name: file.name.replace(/\.[^/.]+$/, ""),
          rawText: text
        });
      }

      document.getElementById('poolBadge').innerText = currentPool.length;
      evaluatePool();
    }

    // Handle Manual Candidate Addition
    function addManualCandidate() {
      const nameInput = document.getElementById('manualName');
      const textInput = document.getElementById('manualText');

      if (!nameInput.value.trim() || !textInput.value.trim()) {
        alert("Please enter both candidate name and resume text.");
        return;
      }

      currentPool.push({
        id: "C-" + Math.floor(100 + Math.random() * 900),
        name: nameInput.value.trim(),
        rawText: textInput.value.trim()
      });

      nameInput.value = "";
      textInput.value = "";
      document.getElementById('poolBadge').innerText = currentPool.length;
      evaluatePool();
    }

    function clearPool() {
      currentPool = [];
      document.getElementById('poolBadge').innerText = "0";
      document.getElementById('resultsContainer').innerHTML = `
        <div id="emptyState" class="border border-slate-800 border-dashed rounded-xl p-12 text-center text-slate-500 space-y-3">
          <i data-lucide="inbox" class="w-10 h-10 mx-auto text-slate-600"></i>
          <p class="text-xs">Pool cleared. Upload new resumes to start evaluating.</p>
        </div>
      `;
      lucide.createIcons();
    }

    // Extract Keywords from JD
    function extractKeywordsFromJD(jdText) {
      const words = jdText.toLowerCase().match(/\b[a-z0-9\.\+\#\-]+\b/g) || [];
      const commonTech = [
        "node.js", "nodejs", "python", "java", "react", "express", "mongodb", "postgresql", 
        "docker", "kubernetes", "aws", "jest", "mocha", "pytest", "sql", "rest", "api", "ci/cd"
      ];
      return Array.from(new Set(words.filter(w => commonTech.includes(w))));
    }

    // Dynamic NLP Ranking Engine
    function evaluatePool() {
      if (currentPool.length === 0) return;

      const jdText = document.getElementById('jdText').value.toLowerCase();
      const semWeight = parseInt(document.getElementById('semWeightSlider').value) / 100;
      const keyWeight = (100 - parseInt(document.getElementById('semWeightSlider').value)) / 100;

      const targetSkills = extractKeywordsFromJD(jdText);

      const evaluated = currentPool.map(candidate => {
        const resumeLower = candidate.rawText.toLowerCase();
        
        let exactMatches = [];
        let semanticBridges = [];
        let missingSkills = [];

        targetSkills.forEach(skill => {
          if (resumeLower.includes(skill)) {
            exactMatches.push(skill.toUpperCase());
          } else {
            // Check for semantic equivalence in knowledge map
            let matchedViaSemantic = false;
            for (let [synonym, coreSkill] of Object.entries(semanticMap)) {
              if (coreSkill.toLowerCase() === skill && resumeLower.includes(synonym)) {
                semanticBridges.push({ synonym: synonym.toUpperCase(), core: coreSkill.toUpperCase() });
                matchedViaSemantic = true;
                break;
              }
            }
            if (!matchedViaSemantic) {
              missingSkills.push(skill.toUpperCase());
            }
          }
        });

        const totalSkills = Math.max(targetSkills.length, 1);
        const keywordScore = (exactMatches.length / totalSkills) * 100;
        const semanticScore = ((exactMatches.length + semanticBridges.length) / totalSkills) * 100;

        const finalScore = Math.min(100, Math.round((semanticScore * semWeight) + (keywordScore * keyWeight)));

        return {
          ...candidate,
          exactMatches,
          semanticBridges,
          missingSkills,
          keywordScore: Math.round(keywordScore),
          semanticScore: Math.round(semanticScore),
          finalScore
        };
      });

      // Sort candidate rankings from highest match score to lowest
      evaluated.sort((a, b) => b.finalScore - a.finalScore);

      renderResults(evaluated);
    }

    // Render Dynamic Results to UI
    function renderResults(rankedList) {
      const container = document.getElementById('resultsContainer');
      container.innerHTML = "";

      rankedList.forEach((c, index) => {
        const isTop3 = index < 3;
        const rank = index + 1;

        const card = document.createElement('div');
        card.className = `border rounded-xl p-5 transition-all duration-300 ${
          isTop3 ? 'border-indigo-500/50 bg-slate-900 shadow-lg shadow-indigo-950/30' : 'border-slate-800/80 bg-slate-900/40'
        }`;

        let top3ExplanationHTML = '';
        if (isTop3) {
          top3ExplanationHTML = `
            <div class="mt-4 pt-4 border-t border-slate-800/80 bg-indigo-950/20 -mx-5 -mb-5 p-4 rounded-b-xl space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wider text-indigo-400 flex items-center gap-1.5">
                  <i data-lucide="shield-check" class="w-3.5 h-3.5"></i> Top 3 Justification Report
                </span>
                <span class="text-[10px] text-slate-400 font-mono">Explainable AI</span>
              </div>
              
              <p class="text-xs text-slate-300 leading-relaxed">
                <strong>Ranked #${rank} Candidate:</strong> Candidate scored <strong>${c.finalScore}%</strong> overall. Found <strong>${c.exactMatches.length}</strong> exact tech match(es) and <strong>${c.semanticBridges.length}</strong> contextual skill equivalences.
              </p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                <div class="bg-slate-900/80 border border-slate-800 p-2.5 rounded-lg space-y-1">
                  <span class="text-emerald-400 font-medium flex items-center gap-1">
                    <i data-lucide="check-circle" class="w-3 h-3"></i> Matched & Inferred
                  </span>
                  <div class="flex flex-wrap gap-1">
                    ${c.exactMatches.map(m => `<span class="bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 px-1.5 py-0.5 rounded text-[10px]">✓ ${m}</span>`).join('')}
                    ${c.semanticBridges.map(b => `<span class="bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 px-1.5 py-0.5 rounded text-[10px]">≈ ${b.synonym} (${b.core})</span>`).join('')}
                    ${(c.exactMatches.length === 0 && c.semanticBridges.length === 0) ? '<span class="text-slate-500 text-[10px]">None matched</span>' : ''}
                  </div>
                </div>

                <div class="bg-slate-900/80 border border-slate-800 p-2.5 rounded-lg space-y-1">
                  <span class="text-rose-400 font-medium flex items-center gap-1">
                    <i data-lucide="x-circle" class="w-3 h-3"></i> Missing Requirements
                  </span>
                  <div class="flex flex-wrap gap-1">
                    ${c.missingSkills.length > 0 ? c.missingSkills.map(m => `<span class="bg-rose-500/10 text-rose-300 border border-rose-500/20 px-1.5 py-0.5 rounded text-[10px]">✕ ${m}</span>`).join('') : '<span class="text-slate-500 text-[10px]">No missing skills</span>'}
                  </div>
                </div>
              </div>
            </div>
          `;
        }

        card.innerHTML = `
          <div class="flex items-start justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full ${isTop3 ? 'bg-indigo-600 text-white font-bold' : 'bg-slate-800 text-slate-400'} flex items-center justify-center text-xs font-mono">
                #${rank}
              </div>
              <div>
                <h3 class="font-bold text-slate-100">${c.name}</h3>
                <p class="text-xs text-slate-400 line-clamp-2 max-w-xl mt-0.5">${c.rawText}</p>
              </div>
            </div>
            <div class="text-right">
              <div class="text-lg font-bold font-mono ${isTop3 ? 'text-indigo-400' : 'text-slate-300'}">${c.finalScore}%</div>
              <div class="text-[10px] text-slate-500 flex gap-2 font-mono">
                <span>Sem: ${c.semanticScore}%</span>
                <span>Key: ${c.keywordScore}%</span>
              </div>
            </div>
          </div>
          ${top3ExplanationHTML}
        `;

        container.appendChild(card);
      });

      lucide.createIcons();
    }
  </script>
</body>
</html>
